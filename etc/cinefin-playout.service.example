[Unit]
Description=Cinefin Playout Agent — mpv supervisor + WebSocket control relay
After=network.target
# The agent spawns and supervises mpv itself — do NOT also run a standalone
# cinefin-mpv.service; disable it if present.

[Service]
Type=simple
User=YOUR_USERNAME
Group=YOUR_USERNAME

# Fallback X display for a desktop-session mpv: used only when the launch
# config's graphics.display is blank (harmless if unused; DRM mode ignores it).
# The launch config is set from Cinefin and kept in the agent's state file.
Environment=DISPLAY=:0
# For DRM mode (hostconfig graphics.mode = "drm"), grant device access:
# SupplementaryGroups=video render
# There is no config file: startup options are flags (--listen, --port, --mpv,
# --state-dir, --display, --mode). State (token, launch config) lives in
# ~/.local/state/cinefin-playout for the User above. --no-ui keeps the service
# headless. Upgrading from 0.1: drop --config /etc/cinefin-playout/config.toml
# here; it is no longer read.
#
# mpv reads mpv.conf from ~/.local/state/cinefin-playout/mpv, not ~/.config/mpv.
# For a config kept elsewhere, add --mpv-config /etc/cinefin-playout/mpv.conf.
ExecStart=/usr/local/bin/cinefin-playout --no-ui

Restart=always
RestartSec=3
StartLimitIntervalSec=0

# Single static Go binary — no venv, no interpreter.
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
