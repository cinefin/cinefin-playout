[Unit]
Description=Cinefin Playout Agent — mpv supervisor + WebSocket control relay
After=network.target
# The agent spawns and supervises mpv itself — do NOT also run a standalone
# cinefin-mpv.service; disable it if present.

[Service]
Type=simple
User=YOUR_USERNAME
Group=YOUR_USERNAME

# Fallback X display for a desktop-session mpv: used only when the launch
# config's mpv.graphics.display is blank (harmless if unused; DRM mode ignores
# it). The launch config lives in config.toml's [mpv.graphics]/[mpv.audio],
# normally set from Cinefin (PUT /hostconfig) or hand-edited.
Environment=DISPLAY=:0
# For DRM mode (hostconfig graphics.mode = "drm"), grant device access:
# SupplementaryGroups=video render
# Config search order: --config flag, then $CINEFIN_PLAYOUT_CONFIG, then
# ./config.toml, ~/.config/cinefin-playout/config.toml, /etc/…/config.toml.
# --no-ui keeps the service headless even for a -tags ui build (the tray defaults
# on); drop it if you want the tray in an interactive session.
ExecStart=/usr/local/bin/cinefin-playout --config /etc/cinefin-playout/config.toml --no-ui

Restart=always
RestartSec=3
StartLimitIntervalSec=0

# Single static Go binary — no venv, no interpreter.
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
